<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Spinner, nightly render at 23:00 local time.
  Template: mac/install.sh replaces __HOME__ and __PATH__ and installs it to
  ~/Library/LaunchAgents/com.bassboat.spinner.plist. No secrets here: the
  ElevenLabs key is read from ~/.bassboat.env by render/queue.mjs.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.bassboat.spinner</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd "__HOME__/BassBoat" &amp;&amp; echo "=== $(date) spinner start" &amp;&amp; exec node "__HOME__/BassBoat/render/queue.mjs"</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/BassBoat</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>HYPERFRAMES_SKIP_SKILLS</key>
    <string>1</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>__HOME__/BassBoat/logs/spinner.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/BassBoat/logs/spinner.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
