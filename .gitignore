# dependencies
node_modules/

# HyperFrames projects generated by render/build.mjs (rebuilt every render)
week/*/*/hf/
**/hf/renders/
.hyperframes/

# temp files
*.tmp
*.tmp.mp4

# render pipeline: large test outputs stay local; the 5-second style tests
# (render/tests/style-*.mp4) and the contact sheet (render/tests/styles.jpg) are committed
render/tests/.work/
render/tests/e2e-*/
render/tests/*.mp4
!render/tests/style-*.mp4

# Mac logs and secrets (secrets live in ~/.bassboat.env, never here)
logs/
.env
*.env
